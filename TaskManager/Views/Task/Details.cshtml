@model TaskManager.Models.TaskItem
@{
    ViewData["Title"] = Model.Title;
    var comments = ViewBag.Comments as IEnumerable<TaskManager.Models.Comment>;
    var statuses = ViewBag.Statuses as IEnumerable<string>;
    var developers = ViewBag.Developers as IEnumerable<TaskManager.Models.User>;
    var currentUserId = ViewBag.CurrentUserId as int? ?? 0;
    var currentRole = ViewBag.CurrentUserRole as string;
    var canEdit = ViewBag.CanEdit as bool? ?? false;
    var canChangeStatus = ViewBag.CanChangeStatus as bool? ?? false;
}

<div class="container-fluid mt-4">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Задачи</a></li>
                    <li class="breadcrumb-item active">@Model.Title</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <!-- Карточка задачи -->
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="m-0 font-weight-bold text-primary">@Model.Title</h5>
                    <span class="badge bg-@GetPriorityBadgeClass(Model.Priority)">
                        @Model.GetPriorityName()
                    </span>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Описание</label>
                        <p class="text-muted">@(Model.Description ?? "Нет описания")</p>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Статус</label>
                            <div class="d-flex align-items-center">
                                <span class="badge bg-@GetStatusBadgeClass(Model.StatusName) me-2">
                                    @Model.StatusName
                                </span>
                                @if (canChangeStatus)
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <select name="status" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                                            @foreach (var status in statuses ?? Enumerable.Empty<string>())
                                            {
                                                <option value="@status" selected="@(status == Model.StatusName)">@status</option>
                                            }
                                        </select>
                                    </form>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Срок выполнения</label>
                            <p class="mb-0">@(Model.DueDate?.ToString("dd.MM.yyyy") ?? "Не установлен")</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Проект</label>
                            <p class="mb-0">
                                <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId">
                                    @(Model.Project?.Title ?? "—")
                                </a>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Исполнитель</label>
                            <div class="d-flex align-items-center">
                                <span>@(Model.Assignee?.Name ?? "Не назначен")</span>
                                @if (canEdit)
                                {
                                    <form asp-action="AssignUser" method="post" class="ms-2">
                                        <input type="hidden" name="taskId" value="@Model.Id" />
                                        <select name="assigneeId" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                                            <option value="">Не назначен</option>
                                            @foreach (var dev in developers ?? Enumerable.Empty<TaskManager.Models.User>())
                                            {
                                                <option value="@dev.Id" selected="@(dev.Id == Model.AssigneeId)">@dev.Name</option>
                                            }
                                        </select>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-muted small">
                    Создано: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <span> | Обновлено: @Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</span>
                    }
                </div>
            </div>

            <!-- Комментарии -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">Комментарии (@(comments?.Count() ?? 0))</h6>
                </div>
                <div class="card-body">
                    @if (comments == null || !comments.Any())
                    {
                        <p class="text-muted text-center mb-0">Комментариев пока нет</p>
                    }
                    else
                    {
                        <div class="comments-list">
                            @foreach (var comment in comments)
                            {
                                <div class="comment-item border-bottom pb-3 mb-3">
                                    <div class="d-flex justify-content-between mb-2">
                                        <strong>@comment.Author?.Name</strong>
                                        <small class="text-muted">@comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                    </div>
                                    <p class="mb-2">@comment.Text</p>
                                    @if (comment.UserId == currentUserId || currentRole == "Администратор")
                                    {
                                        <form asp-controller="Comment" asp-action="Delete" method="post" class="d-inline" 
                                              onsubmit="return confirm('Удалить комментарий?')">
                                            <input type="hidden" name="id" value="@comment.Id" />
                                            <input type="hidden" name="taskId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i> Удалить
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Форма добавления комментария -->
                    <form asp-action="AddComment" method="post" class="mt-4">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <textarea name="text" class="form-control" rows="3" placeholder="Добавить комментарий..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-comment"></i> Отправить
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Боковая панель -->
        <div class="col-lg-4">
            <!-- Быстрые действия -->
            @if (canChangeStatus)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header">
                        <h6 class="m-0 font-weight-bold text-primary">Быстрые действия</h6>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            @{
                                var nextStatus = GetNextStatus(Model.StatusName);
                                if (!string.IsNullOrEmpty(nextStatus))
                                {
                                    <form asp-action="UpdateStatus" method="post">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="status" value="@nextStatus" />
                                        <button type="submit" class="btn btn-success w-100">
                                            <i class="fas fa-arrow-right"></i> Перейти в: @nextStatus
                                        </button>
                                    </form>
                                }
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Информация -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">Информация</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0 small">
                        <dt class="col-6">ID задачи:</dt>
                        <dd class="col-6">@Model.Id</dd>
                        <dt class="col-6">Приоритет:</dt>
                        <dd class="col-6">@Model.Priority</dd>
                        <dt class="col-6">Дата создания:</dt>
                        <dd class="col-6">@Model.CreatedAt.ToString("dd.MM.yyyy")</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(string status) => status switch
    {
        "К выполнению" => "secondary",
        "В работе" => "primary",
        "На проверке" => "warning",
        "Завершено" => "success",
        _ => "light"
    };

    string GetPriorityBadgeClass(int priority) => priority switch
    {
        1 => "info",
        2 => "success",
        3 => "warning",
        4 => "danger",
        _ => "secondary"
    };

    string GetNextStatus(string currentStatus) => currentStatus switch
    {
        "К выполнению" => "В работе",
        "В работе" => "На проверке",
        "На проверке" => "Завершено",
        _ => null
    };
}

@section Styles {
    <style>
        .comment-item:last-child {
            border-bottom: none !important;
            margin-bottom: 0 !important;
            padding-bottom: 0 !important;
        }
        .breadcrumb-item + .breadcrumb-item::before {
            content: "/";
        }
    </style>
}

@section Scripts {
    <script>
        // Автофокус на поле комментария при клике
        document.querySelectorAll('textarea[name="text"]').forEach(el => {
            el.addEventListener('focus', function() {
                this.scrollIntoView({ behavior: 'smooth', block: 'center' });
            });
        });
    </script>
}
